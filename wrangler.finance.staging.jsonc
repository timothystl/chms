{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "timothy-finance-app-staging",
  "main": "apps/finance/shell.js",
  "compatibility_date": "2026-09-09",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "finance-staging.timothystl.org",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "FINANCE_DB",
      "database_name": "timothy-finance-db-staging",
      "database_id": "59dfc662-9f43-469f-936e-d7a0d3247036",
      "migrations_dir": "apps/finance/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FACILITY_FILES",
      "bucket_name": "timothy-finance-files-staging"
    }
  ],

  "services": [
    {
      "binding": "CONNECT_SERVICE",
      "service": "timothy-connect-staging"
    },
    {
      "binding": "PAYROLL_SERVICE",
      "service": "tlc-newsletter-admin"
    }
  ],
  "vars": {
    "ENVIRONMENT": "staging",
    "RELEASE_SHA": "unreleased",
    "FINANCE_ACCESS_TEAM_DOMAIN": "timothystl.cloudflareaccess.com",
    "FINANCE_ACCESS_AUD": "3c8cae1345ea2e2e15a88e01d7801c27ec7a57bfb73952098bd4b1929ab01717",
    "FINANCE_QB_ENABLED": "0",
    "FINANCE_QB_ENVIRONMENT": "sandbox"
  },
  "observability": {
    "enabled": true
  }
}
